></mxCell><mxCell id="v64" value="생성물은 apply 전까지 소스에 반영되지 않는다(v4 Step 3). CI에서는 종료 코드로 분기(사용가이드 §13)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;" vertex="1" parent="v53"><mxGeometry x="60" y="120" width="1200" height="30" as="geometry"/></mxCell><mxCell id="v65" value="E. cta graph&#xa;eval · demo" style="swimlane;html=1;startSize=40;horizontal=0;collapsible=0;fillColor=none;fontSize=12;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="v3"><mxGeometry x="0" y="880" width="1740" height="240" as="geometry"/></mxCell><mxCell id="v66" value="cta graph [--coverage]" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="v65"><mxGeometry x="60" y="35" width="130" height="80" as="geometry"/></mxCell><mxCell id="v67" value="Java 소스 파싱 adapters/graph_builder.py + calls.py&#xa;노드 · DECLARES · CREATES · CALLS(확신도, main만)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="v65"><mxGeometry x="260" y="35" width="270" height="80" as="geometry"/></mxCell><mxCell id="v68" value="JaCoCo 실측 adapters/coverage.py&#xa;테스트 → 메서드 COVERS 엣지 (--coverage)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="v65"><mxGeometry x="600" y="35" width="250" height="80" as="geometry"/></mxCell><mxCell id="v69" value="graph/neo4j_store.py 적재&#xa;(접속 실패 → 파싱 폴백, graph_access.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;" vertex="1" parent="v65"><mxGeometry x="920" y="35" width="250" height="80" as="geometry"/></mxCell><mxCell id="v70" value="query_code_graph(callers 포함) · TestLocator · ImpactFinder&#xa;&quot;기존 테스트 찾기&quot;는 실측, 영향 범위는 추정 표기" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;" vertex="1" parent="v65"><mxGeometry x="1240" y="