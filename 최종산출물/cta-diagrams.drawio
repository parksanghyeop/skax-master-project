a6;fontSize=9;align=center;" vertex="1" parent="graph"><mxGeometry x="130" y="40" width="105" height="48" as="geometry"/></mxCell><mxCell id="v54" value="impact.py [신규]&#xa;CALLS → 호출자 목록&#xa;(ImpactFinder 구현)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;align=center;fontStyle=1;" vertex="1" parent="graph"><mxGeometry x="245" y="40" width="105" height="48" as="geometry"/></mxCell><mxCell id="e55" value="구현" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v42" target="graph"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sandbox" value="sandbox 층 — 실행 장치 (R6). 무엇을 실행하는지 모른다" style="swimlane;startSize=30;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="700" height="80" as="geometry"/></mxCell><mxCell id="v56" value="local_sandbox.py [기본]&#xa;이 PC의 Maven·JDK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;" vertex="1" parent="sandbox"><mxGeometry x="15" y="36" width="210" height="36" as="geometry"/></mxCell><mxCell id="v57" value="docker_sandbox.py --runner docker&#xa;네트워크 차단 · 마운트 통제" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;" vertex="1" parent="sandbox"><mxGeometry x="250" y="36" width="220" height="36" as="geometry"/></mxCell><mxCell id="v58" value="factory.py choose_runner&#xa;명시 없으면 local · 폴백 없음" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;" vertex="1" parent="sandbox"><mxGeometry x="475" y="36" width="210" height="36" as="geometry"/></mxCell><mxCell id="e59" value="runner → 명령 실행 위임" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="adapters" target="sandbox"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v60" value="대상 Maven 프로젝트 (src/main · src/test · pom.xml · git)&#xa;adapters가 소스 읽기 · 테스트 파일 쓰기" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="1220" width="220" height="60" as="geometry"/></mxCell><mxCell id="v61" value="로컬 Maven · JDK 17+ (~/.m2)&#xa;또는 Docker 컨테이너(격리)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;dashed=1;" vertex="1" parent="1"><mxGeometry x="300" y="1220" width="250" height="60" as="geometry"/></mxCell><mxCell id="v62" value="Neo4j (선택)&#xa;없으면 파싱 폴백" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;dashed=1;" vertex="1" parent="1"><mxGeometry x="780" y="1220" width="200" height="60" as="geometry"/></mxCell><mxCell id="e63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="adapters" target="v60"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="1010"/><mxPoint x="20" y="1250"/></Array></mxGeometry></mxCell><mxCell id="e64" value="mvn test (선택 실행만)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.55;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="sandbox" target="v61"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e65" value="bolt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="graph" target="v62"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="llm" value="llm 층 — LLM 호출의 유일한 통로 (R7). CI는 재생 모드, 카세트 없으면 실패(실호출 폴백 금지)" style="swimlane;startSize=30;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1180" y="220" width="580" height="300" as="geometry"/></mxCell><mxCell id="v66" value="config.py make_llm_client() · make_embedding_client() · chat_model.py make_chat_model()&#xa;클라이언트 생성의 유일한 입구 · .env(CTA_GATEWAY_URL/API_KEY/LLM_MODEL/EMBEDDING_MODEL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;" vertex="1" parent="llm"><mxGeometry x="15" y="40" width="550" height="44" as="geometry"/></mxCell><mxCell id="v67" value="generation.py&#xa;TestCodeGenerator&#xa;(legacy write 노드)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=center;" vertex="1" parent="llm"><mxGeometry x="15" y="100" width="130" height="60" as="geometry"/></mxCell><mxCell id="v68" value="AzureChatOpenAI 모델&#xa;(deep 메인·서브 공유)&#xa;+ NoCallChatModel(재생)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=center;" vertex="1" parent="llm"><mxGeometry x="155" y="100" width="130" height="60" as="geometry"/></mxCell><mxCell id="v69" value="intent.py&#xa;IntentClassifier&#xa;(maintain 의도 분류)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=center;" vertex="1" parent="llm"><mxGeometry x="295" y="100" width="130" height="60" as="geometry"/></mxCell><mxCell id="v70" value="embeddings.py [신규]&#xa;판단 메모 상황 임베딩&#xa;(자연어만 · 코드 검색 금지)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=center;fontStyle=1;" vertex="1" parent="llm"><mxGeometry x="435" y="100" width="130" height="60" as="geometry"/></mxCell><mxCell id="v71" value="replay.py 카세트 v1 · model_cassette.py 카세트 v2(미들웨어) · embeddings 기록(글→벡터)&#xa;요청 키 = deployment+시스템 프롬프트+메시지+도구 이름 · 완전 일치 · 폴백 없음" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;" vertex="1" parent="llm"><mxGeometry x="15" y="175" width="370" height="50" as="geometry"/></mxCell><mxCell id="v72" value="metering.py 토큰·예산&#xa;masking.py 시크릿 가림" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;" vertex="1" parent="llm"><mxGeometry x="395" y="175" width="170" height="50" as="geometry"/></mxCell><mxCell id="v73" value="prompts/*.md: system · write_test · write_test_append · classify_intent (코드 밖 데이터)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;" vertex="1" parent="llm"><mxGeometry x="15" y="240" width="550" height="30" as="geometry"/></mxCell><mxCell id="v74" value="사내 LLM 게이트웨이&#xa;Azure OpenAI 호환 · deployment = 모델(gpt-5)&#xa;주소·키는 환경변수/.env로만" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;dashed=1;" vertex="1" parent="1"><mxGeometry x="1180" y="110" width="400" height="60" as="geometry"/></mxCell><mxCell id="e75" value="HTTPS (실호출 시)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="llm" target="v74"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e76" value="생성 요청 / 모델 호출" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="engine" target="llm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="safe" value="안전장치 — 결정적, LLM 호출 없음 (R2). 테스트를 만든 에이전트는 판정에 관여하지 못한다" style="swimlane;startSize=30;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1180" y="560" width="580" height="400" as="geometry"/></mxCell><mxCell id="v77" value="게이트 루프 core/submit.py generate_with_gates&#xa;run_writer → 게이트 → 탈락 사유를 지침서에 붙여 재생성 (max_retries 기본 3)&#xa;소진 시 human_review(사람 확인) · 엔진 실패 시 not_passed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="safe"><mxGeometry x="15" y="40" width="550" height="60" as="geometry"/></mxCell><mxCell id="v78" value="게이트 6개 — core/gates.py 실행기 + adapters/java/gates.py·mutation.py·regression.py&#xa;① AssertIntegrity(메서드 단위·허용 목록) ② SkipAnnotation ③ FileScope(허용 파일만)&#xa;④ Coverage(JaCoCo 변경 라인 80% / 분기 70%, 회귀 금지) ⑤ Mutation(PIT 검출률) ⑥ BugReproduction(수정 전 코드에서 실패해야)&#xa;--fast는 ④⑤ 생략. 애매하면 탈락 → 사람 확인(보수적)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="safe"><mxGeometry x="15" y="115" width="550" height="80" as="geometry"/></mxCell><mxCell id="v79" value="조치 결정 규칙표 core/pipeline/decide.py (maintain)&#xa;(의도 × 기존 테스트 상태) → create_test / no_action / escalate / ask&#xa;refactor+실패 → escalate · unclear → ask · trivial → no_action. 기대값 자동 갱신 행 없음(R3)&#xa;영향 범위(호출자, 추정)는 지침서 내용에만 — 길(kind)에는 못 들어간다(ADR-0026 D2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="safe"><mxGeometry x="15" y="210" width="550" height="70" as="geometry"/></mxCell><mxCell id="v80" value="반복 상한 core/agent/limits.py RunLedger&#xa;시도 ≤8(하드 캡) · 4회마다 묻기 · 같은 실패 2회 → ask · 시간 초과/실행 거부 → impossible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="safe"><mxGeometry x="15" y="285" width="320" height="50" as="geometry"/></mxCell><mxCell id="v81" value="사람 개입 core/user_gate.py&#xa;InterruptUserGate: interrupt()로 정지 →&#xa;터미널 질문 → 답으로 같은 지점 재개" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8f6;strokeColor=#b5739d;fontSize=10;align=center;" vertex="1" parent="safe"><mxGeometry x="350" y="285" width="215" height="50" as="geometry"/></mxCell><mxCell id="v82" value="cta.toml [gates]·[retry]로 기준치·상한 조정 (core/config.py). 환경변수 &gt; .env &gt; cta.toml" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;" vertex="1" parent="safe"><mxGeometry x="15" y="345" width="550" height="30" as="geometry"/></mxCell><mxCell id="e83" value="generate_with_gates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.98;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v4" target="safe"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1160" y="200"/><mxPoint x="1160" y="540"/></Array></mxGeometry></mxCell><mxCell id="e84" value="run_writer(탈락 사유 포함 지침서)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.2;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="safe" target="engine"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e85" value="ask ⏸ → interrupt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.82;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="engine" target="safe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="state" value=".cta/ 상태 저장소 — 생성물은 제안으로 보관, cta apply를 쳐야만 소스 반영(v4 Step 3)" style="swimlane;startSize=30;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1180" y="1000" width="580" height="90" as="geometry"/></mxCell><mxCell id="v86" value="proposals/ 제안 (같은 클래스는 이어 붙임)&#xa;cta diff → apply / discard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=center;" vertex="1" parent="state"><mxGeometry x="15" y="38" width="170" height="40" as="geometry"/></mxCell><mxCell id="v87" value="escalations/ 사람 확인 항목&#xa;종료 코드 3 → cta resolve" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=center;" vertex="1" parent="state"><mxGeometry x="200" y="38" width="180" height="40" as="geometry"/></mxCell><mxCell id="v88" value="memos/ 판단 메모 (수정)&#xa;상황 요약 + 임베딩 벡터 저장" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;align=center;" vertex="1" parent="state"><mxGeometry x="395" y="38" width="170" height="40" as="geometry"/></mxCell><mxCell id="e89" value="게이트 통과 → 제안 / 소진 → 사람 확인" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="safe" target="state"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e90" value="질문 ⏸ → 사용자 답 (ask_on_terminal)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="safe" target="v3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1790" y="600"/><mxPoint x="1790" y="95"/><mxPoint x="115" y="95"/></Array></mxGeometry></mxCell><mxCell id="v91" value="범례" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="1120" width="580" height="70" as="geometry"/></mxCell><mxCell id="v92" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="v91"><mxGeometry x="10" y="26" width="22" height="12" as="geometry"/></mxCell><mxCell id="v93" value="cli 층" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="v91"><mxGeometry x="36" y="20" width="80" height="22" as="geometry"/></mxCell><mxCell id="v94" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="v91"><mxGeometry x="10" y="46" width="22" height="12" as="geometry"/></mxCell><mxCell id="v95" value="core 층" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="v91"><mxGeometry x="36" y="40" width="80" height="22" as="geometry"/></mxCell><mxCell id="v96" value="" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="v91"><mxGeometry x="125" y="26" width="22" height="12" as="geometry"/></mxCell><mxCell id="v97" value="adapters/java" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="v91"><mxGeometry x="151" y="20" width="80" height="22" as="geometry"/></mxCell><mxCell id="v98" value="" style="rounded=0;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="v91"><mxGeometry x="125" y="46" width="22" height="12" as="geometry"/></mxCell><mxCell id="v99" value="llm 층(LLM 호출)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="v91"><mxGeometry x="151" y="40" width="80" height="22" as="geometry"/></mxCell><mxCell id="v100" value="" style="rounded=0;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="v91"><mxGeometry x="240" y="26" width="22" height="12" as="geometry"/></mxCell><mxCell id="v101" value="graph" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="v91"><mxGeometry x="266" y="20" width="80" height="22" as="geometry"/></mxCell><mxCell id="v102" value="" style="rounded=0;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="v91"><mxGeometry x="240" y="46" width="22" height="12" as="geometry"/></mxCell><mxCell id="v103" value="sandbox" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="v91"><mxGeometry x="266" y="40" width="80" height="22" as="geometry"/></mxCell><mxCell id="v104" value="" style="rounded=0;html=1;fillColor=#fce8f6;strokeColor=#b5739d;" vertex="1" parent="v91"><mxGeometry x="355" y="26" width="22" height="12" as="geometry"/></mxCell><mxCell id="v105" value="사람 개입" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="v91"><mxGeometry x="381" y="20" width="80" height="22" as="geometry"/></mxCell><mxCell id="v106" value="" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="v91"><mxGeometry x="355" y="46" width="22" height="12" as="geometry"/></mxCell><mxCell id="v107" value=".cta 상태/안전장치 틀" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="v91"><mxGeometry x="381" y="40" width="80" height="22" as="geometry"/></mxCell><mxCell id="v108" value="" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="v91"><mxGeometry x="470" y="26" width="22" height="12" as="geometry"/></mxCell><mxCell id="v109" value="외부(점선)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="v91"><mxGeometry x="496" y="20" width="80" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3. User Command Flows"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="Code Test Agent (cta) — CLI 명령별 흐름" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=22;fontColor=#1e1e1e;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="v2" value="종료 코드: 0 정상 · 3 사람 확인 필요(실패 아님) · 2 품질 미달 · 1 오류. 빨간 LLM 배지가 붙은 단계만 LLM을 호출한다(llm 층 경유, 녹음·재생 가능). 색 = 층(cli 파랑 · core 초록 · adapters 노랑 · llm 빨강 · graph 보라 · .cta 회색)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1700" height="40" as="geometry"/></mxCell><mxCell id="v3" value="cta 명령" style="swimlane;html=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;collapsible=0;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1740" height="1120" as="geometry"/></mxCell><mxCell id="v4" value="A. cta generate" style="swimlane;html=1;startSize=40;horizontal=0;collapsible=0;fillColor=none;fontSize=12;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="v3"><mxGeometry x="0" y="30" width="1740" height="200" as="geometry"/></mxCell><mxCell id="v5" value="cta generate &lt;파일명&gt; | --class C&#xa;[--max-methods N] [--engine deep] [--fast]" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="v4"><mxGeometry x="60" y="40" width="150" height="80" as="geometry"/></mxCell><mxCell id="v6" value="[1/4] 재료 수집 adapters/materials.py&#xa;테스트 없는 메서드 선정 · 확인 항목(분기·경계·예외·null) · 기존 테스트 파일" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="v4"><mxGeometry x="280" y="40" width="250" height="80" as="geometry"/></mxCell><mxCell id="v7" value="[2/4] 객체 생성법 확인&#xa;직접 생성 / builder / mock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="v4"><mxGeometry x="600" y="40" width="170" height="80" as="geometry"/></mxCell><mxCell id="v8" value="[3/4] 작성 엔진 (페이지 1)&#xa;legacy writer_graph | deep core/agent&#xa;쓰기→실행→진단 반복 ≤8회, ⏸ 4회마다 질문" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;" vertex="1" parent="v4"><mxGeometry x="840" y="40" width="270" height="80" as="geometry"/></mxCell><mxCell id="v9" value="LLM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#b85450;fontColor=#ffffff;fontSize=10;fontStyle=1;" vertex="1" parent="v4"><mxGeometry x="1074" y="32" width="34" height="16" as="geometry"/></mxCell><mxCell id="v10" value="[4/4] 게이트 ①~⑥ (결정적)&#xa;core/submit.py 탈락 사유 → 재생성 ≤3회&#xa;--fast: ④커버리지 ⑤뮤테이션 생략" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;" vertex="1" parent="v4"><mxGeometry x="1180" y="40" width="250" height="80" as="geometry"/></mxCell><mxCell id="v11" value=".cta/proposals&#xa;제안 저장 (소스 미반영)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=center;" vertex="1" parent="v4"><mxGeometry x="1500" y="40" width="160" height="80" as="geometry"/></mxCell><mxCell id="v12" value="종료 0&#xa;cta diff로 검토" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="v4"><mxGeometry x="1730" y="40" width="110" height="80" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="v4" source="v5" target="v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="v4" source="v6" target="v7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="v4" source="v7" target="v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="v4" source="v8" target="v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="v4" source="v10" target="v11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="v4" source="v11" target="v12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v19" value="같은 테스트 클래스의 대기 제안이 있으면 그 위에 이어서 생성(덮어쓰지 않음). 게이트 재시도 소진 → 사람 확인(종료 3) · 품질 미달(종료 2). --engine deep: --record 파일 / --replay 파일 로 LLM 호출 녹음·재생(기록과 어긋나면 실패, 실호출 폴백 없음). 실행은 sandbox(local 기본 / docker)에서 선택한 테스트만 돈다(R5)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;" vertex="1" parent="v4"><mxGeometry x="60" y="135" width="1600" height="40" as="geometry"/></mxCell><mxCell id="v20" value="B. cta maintain" style="swimlane;html=1;startSize=40;horizontal=0;collapsible=0;fillColor=none;fontSize=12;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="v3"><mxGeometry x="0" y="230" width="1740" height="300" as="geometry"/></mxCell><mxCell id="v21" value="cta maintain --diff HEAD~1&#xa;[--plan-only] [--intent 의도]&#xa;[--impact]" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="v20"><mxGeometry x="60" y="40" width="150" height="80" as="geometry"/></mxCell><mxCell id="v22" value="변경 추출 adapters/changes.py&#xa;git diff → 변경 심볼 + 단서&#xa;(시그니처·접근 제어자·주석만·커밋 메시지·이슈) · 수정 전 소스" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="v20"><mxGeometry x="270" y="40" width="240" height="80" as="geometry"/></mxCell><mxCell id="v23" value="건별 의도 분류 llm/intent.py&#xa;bug_fix / refactor / new_feature / trivial / unclear&#xa;+ 확신도·근거·분석. 실패 → unclear · --intent면 확정" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;" vertex="1" parent="v20"><mxGeometry x="570" y="40" width="240" height="80" as="geometry"/></mxCell><mxCell id="v24" value="LLM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#b85450;fontColor=#ffffff;fontSize=10;fontStyle=1;" vertex="1" parent="v20"><mxGeometry x="774" y="32" width="34" height="16" as="geometry"/></mxCell><mxCell id="v25" value="기존 테스트 찾기 + 검증 실행 + 영향 범위&#xa;TestLocator(COVERS 실측 → 참조 파싱 폴백) → pass / fail / none&#xa;ImpactFinder(CALLS 추정 → 호출자·확신도) → 화면·지침서만" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="v20"><mxGeometry x="870" y="40" width="230" height="80" as="geometry"/></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="v20" source="v21" target="v22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="v20" source="v22" target="v23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="v20" source="v23" target="v25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v29" value="규칙표&#xa;core/pipeline/decide.py&#xa;의도 × 테스트 상태&#xa;(LLM 없음, R2)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="v20"><mxGeometry x="1150" y="30" width="180" height="100" as="geometry"/></mxCell><mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="v20" source="v25" target="v29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v31" value="bug_fix · new_feature → create_test → A의 [3/4]~[4/4] 경로&#xa;bug_fix: 재발 방지 테스트(⑥회귀 게이트: 수정 전 코드에서 실패해야)&#xa;new_feature: 기능 테스트 → 제안" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;" vertex="1" parent="v20"><mxGeometry x="1390" y="50" width="320" height="60" as="geometry"/></mxCell><mxCell id="v32" value="no_action&#xa;refactor+통과(동작 보존 확인) · trivial(주석·공백만)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=center;" vertex="1" parent="v20"><mxGeometry x="1390" y="115" width="320" height="40" as="geometry"/></mxCell><mxCell id="v33" value="escalate / ask → .cta/escalations 저장 후 멈춤 (종료 3)&#xa;refactor+실패: 기대값을 고치지 않고 실패 내용·의심 위치만 정리(R3)&#xa;unclear / refactor+테스트 없음: 사람에게 묻기" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8f6;strokeColor=#b5739d;fontSize=10;align=center;" vertex="1" parent="v20"><mxGeometry x="1390" y="170" width="320" height="60" as="geometry"/></mxCell><mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="v20" source="v29" target="v31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e35" value="refactor+pass · trivial" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="v20" source="v29" target="v32"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1240" y="135"/></Array></mxGeometry></mxCell><mxCell id="e36" value="refactor+fail · unclear" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="v20" source="v29" target="v33"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1240" y="200"/></Array></mxGeometry></mxCell><mxCell id="v37" value="화면에는 변경 건마다 ①의도 판단 ②조치 블록(판단·확신도·근거·영향 범위·할 일)을 적는다(ADR-0015 D2). 확신도는 표시용이며 코드는 이 값으로 분기하지 않는다. --plan-only는 규칙표까지만. 판단 메모(.cta/memos)는 이름 일치 + 상황 임베딩(하이브리드)으로 찾아 참고로 보여 준다. --impact: create_test인 건의 확신 high 호출자를 파생 건(↳)으로 추가해 같은 규칙표를 태운다(깊이 1, [impact] max_callers). 사람 확인이 하나라도 있으면 종료 3." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;" vertex="1" parent="v20"><mxGeometry x="60" y="235" width="1600" height="50" as="geometry"/></mxCell><mxCell id="v38" value="C. cta resolve" style="swimlane;html=1;startSize=40;horizontal=0;collapsible=0;fillColor=none;fontSize=12;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="v3"><mxGeometry x="0" y="530" width="1740" height="200" as="geometry"/></mxCell><mxCell id="v39" value="cta resolve &lt;id&gt; --intended |&#xa;--test-issue | --proceed | --as | --skip" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="v38"><mxGeometry x="60" y="40" width="150" height="80" as="geometry"/></mxCell><mxCell id="v40" value="저장된 사람 확인 항목 읽기&#xa;.cta/escalations/&lt;id&gt;.json&#xa;재개 지점 = 테스트 작성 단계 진입(ADR-0015 D3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=center;" vertex="1" parent="v38"><mxGeometry x="280" y="40" width="250" height="80" as="geometry"/></mxCell><mxCell id="v41" value="사람 결정 → 지침·허용 목록 cli/resolve_cmd.py&#xa;--intended: 실패 테스트 기대값을 새 동작 기준으로&#xa;--test-issue: 테스트를 동작 기준으로 재작성&#xa;--as 의도: 규칙표부터 다시(LLM 없음) · --skip: 기록만" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;" vertex="1" parent="v38"><mxGeometry x="600" y="40" width="300" height="80" as="geometry"/></mxCell><mxCell id="v42" value="A의 [3/4]~[4/4] 경로로 재개&#xa;허용 목록 = 실패한 테스트 메서드만 assert 변경 허용&#xa;나머지는 ①AssertIntegrity 게이트가 보호" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;" vertex="1" parent="v38"><mxGeometry x="970" y="40" width="280" height="80" as="geometry"/></mxCell><mxCell id="v43" value="LLM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#b85450;fontColor=#ffffff;fontSize=10;fontStyle=1;" vertex="1" parent="v38"><mxGeometry x="1214" y="32" width="34" height="16" as="geometry"/></mxCell><mxCell id="v44" value=".cta/proposals 제안&#xa;+ .cta/memos 판단 메모&#xa;(상황 요약 + 임베딩)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=center;" vertex="1" parent="v38"><mxGeometry x="1320" y="40" width="170" height="80" as="geometry"/></mxCell><mxCell id="v45" value="LLM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#b85450;fontColor=#ffffff;fontSize=10;fontStyle=1;" vertex="1" parent="v38"><mxGeometry x="1454" y="32" width="34" height="16" as="geometry"/></mxCell><mxCell id="v46" value="종료 0 / 2 / 3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="v38"><mxGeometry x="1560" y="40" width="110" height="80" as="geometry"/></mxCell><mxCell id="e47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="v38" source="v39" target="v40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="v38" source="v40" target="v41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="v38" source="v41" target="v42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="v38" source="v42" target="v44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="v38" source="v44" target="v46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v52" value="사람이 명시적으로 고른 선택지만 실행한다 — R3는 '사람 확인 없는' 기대값 갱신을 막는 규칙이다. --intended/--test-issue는 실패한 테스트 메서드를 제자리에서 교체한다(허용 목록 밖은 assert 게이트가 보호). 재개가 실패하면 항목을 지우지 않고 --hint 재시도를 안내한다. 판단 메모는 상황 요약을 임베딩해 저장하고 다음 maintain에서 이름 일치 + 코사인으로 참고 자료가 된다." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;" vertex="1" parent="v38"><mxGeometry x="60" y="135" width="1600" height="40" as="geometry"/></mxCell><mxCell id="v53" value="D. cta diff&#xa;apply · discard" style="swimlane;html=1;startSize=40;horizontal=0;collapsible=0;fillColor=none;fontSize=12;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="v3"><mxGeometry x="0" y="730" width="1740" height="150" as="geometry"/></mxCell><mxCell id="v54" value="cta diff [이름]" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="v53"><mxGeometry x="60" y="35" width="120" height="80" as="geometry"/></mxCell><mxCell id="v55" value=".cta/proposals 읽기 cli/proposals.py&#xa;제안 내용을 diff 형식으로 출력" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=center;" vertex="1" parent="v53"><mxGeometry x="250" y="35" width="250" height="80" as="geometry"/></mxCell><mxCell id="v56" value="사람 검토" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8f6;strokeColor=#b5739d;fontSize=10;align=center;" vertex="1" parent="v53"><mxGeometry x="570" y="35" width="130" height="80" as="geometry"/></mxCell><mxCell id="v57" value="cta apply [이름|--all]&#xa;테스트 트리(src/test)에 쓰기 — 이때만 소스 반영" style="rounded=1;whiteSpace=wrap;