flowchart LR
    subgraph SRC["설정 출처 — 왼쪽이 이긴다"]
        direction LR
        E1["① 환경변수<br/>CTA_LLM_MODEL · CTA_GATEWAY_TIMEOUT …"]
        E2["② .env<br/>실행 폴더 → ~/.cta/.env<br/>(시크릿은 여기만)"]
        E3["③ cta.toml<br/>프로젝트 루트, 커밋 가능<br/>시크릿 금지"]
        E4["④ 코드 기본값<br/>v4 설계값"]
        E1 --> E2 --> E3 --> E4
    end

    LOAD["core/config.py load_config<br/>→ CtaConfig<br/>(값은 인자로만 전달 — 환경변수에 쓰지 않는다)"]

    subgraph USE["어디로 가나"]
        direction TB
        G["[gates] line_min 0.80 · branch_min 0.70<br/>max_retries 3 · mutation_min 0.5<br/>→ CoverageGate · MutationGate · 게이트 재시도 루프"]
        R["[retry] ask_every 4 · max_total 8<br/>→ build_writer_graph(ask_every, max_total)"]
        T["[gateway] timeout_sec 300<br/>→ GatewayClient(timeout_default) — 환경변수·.env가 있으면 그쪽"]
        M["[llm] model<br/>→ make_llm_client(model_default) — 환경변수·.env가 있으면 그쪽"]
        B["[budget] max_tokens_per_run (기본 무제한)<br/>→ MeteredClient — 호출 전 검사, 넘으면 멈추고 생성물 되돌림"]
    end

    E3 --> LOAD
    LOAD --> G & R & T & M & B

    WHY["왜 cta.toml이 .env보다 낮나<br/>.env = 사람·기계 단위(키·주소·개인 모델 선택)<br/>cta.toml = 커밋되는 프로젝트 단위<br/>커밋된 파일이 개인 설정을 덮으면 놀랍다<br/><br/>왜 환경변수에 쓰지 않나<br/>MCP 서버처럼 오래 사는 프로세스가 프로젝트를 바꿔도<br/>이전 프로젝트 값이 남지 않게"]

    classDef new fill:#fff3c4,stroke:#d97706,stroke-width:2px
    classDef plain fill:#eef2ff,stroke:#6366f1
    classDef safe fill:#d5f5e0,stroke:#10b981,stroke-width:2px
    classDef dim fill:#f3f4f6,stroke:#9ca3af,stroke-dasharray: 4 4
    class E3,LOAD,R,B new
    class E1,E2,E4,T,M plain
    class G safe
    class WHY dim
