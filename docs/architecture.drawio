dgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="v52" source="v54" target="v55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="v52" source="v55" target="v56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="v52" source="v56" target="v57"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v62" value="cta discard → 제안 폐기 (소스 무변경)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=center;" vertex="1" parent="v52"><mxGeometry x="1360" y="35" width="250" height="40" as="geometry"/></mxCell><mxCell id="v63" value="생성물은 apply 전까지 소스에 반영되지 않는다(v4 Step 3). CI에서는 종료 코드로 분기(사용가이드 §13)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;" vertex="1" parent="v52"><mxGeometry x="60" y="120" width="1200" height="30" as="geometry"/></mxCell><mxCell id="v64" value="E. cta graph&#xa;eval · demo" style="swimlane;html=1;startSize=40;horizontal=0;collapsible=0;fillColor=none;fontSize=12;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="v3"><mxGeometry x="0" y="880" width="1740" height="240" as="geometry"/></mxCell><mxCell id="v65" value="cta graph [--coverage]" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="v64"><mxGeometry x="60" y="35" width