/></mxCell><mxCell id="v56" value="local_sandbox.py [기본]&#xa;이 PC의 Maven·JDK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;" vertex="1" parent="sandbox"><mxGeometry x="15" y="36" width="210" height="36" as="geometry"/></mxCell><mxCell id="v57" value="docker_sandbox.py --runner docker&#xa;네트워크 차단 · 마운트 통제" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;" vertex="1" parent="sandbox"><mxGeometry x="250" y="36" width="220" height="36" as="geometry"/></mxCell><mxCell id="v58" value="factory.py choose_runner&#xa;명시 없으면 local · 폴백 없음" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;" vertex="1" parent="sandbox"><mxGeometry x="475" y="36" width="210" height="36" as="geometry"/></mxCell><mxCell id="e59" value="runner → 명령 실행 위임" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="adapters" target="sandbox"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v60" value="대상 Maven 프로젝트 (src/main · src/test · pom.xml · git)&#xa;adapters가 소스 읽기 · 테스트 파일 쓰기" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="1220" width="220" height="60" as="geometry"/></mxCell><mxCell id="v61" value="로컬 Maven · JDK 17+ (~/.m2)&#xa;또는 Docker 컨테이너(격리)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;dashed=1;" vertex="1" parent="1"><mxGeometry x="300" y="1220" width="250" height="60" as="geometry"/></mxCell><mxCell id="v62" value="Neo4j (선택)&#xa;없으면 파싱 폴백" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;dashed=1;" vertex=