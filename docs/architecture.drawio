Y=0.5;entryDx=0;entryDy=0;" edge="1" parent="legacy" source="v9" target="v8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="212"/><mxPoint x="30" y="142"/></Array></mxGeometry></mxCell><mxCell id="e18" value="같은 실패 반복 /&#xa;4회마다" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="legacy" source="v9" target="v11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="불가능 / 8회" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="legacy" source="v9" target="v12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e20" value="계속(+힌트)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="legacy" source="v11" target="v8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="12" y="312"/><mxPoint x="12" y="153"/></Array></mxGeometry></mxCell><mxCell id="e21" value="중지" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="legacy" source="v11" target="v12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v22" value="노드 함수는 그래프 없이 단독 호출·테스트 가능. LLM은 generator 포트(llm/generation.py) 뒤에만 있다." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;" vertex="1" parent="legacy"><mxGeometry x="50" y="350" width="400" height="40" as="geometry"/></mxCell><mxCell id="deep" value="deep (ADR-0024) — core/agent/ · Deep Agents 메인 test_lead + 서브에이전트 3" style="swimlane;startSize=30;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="engine"><mxGeometry x="480" y="40" width="600" height="410" as="geometry"/></mxCell><mxCell id="v23" value="메인 test_lead (prompts/test_lead.md)&#xa;고유 도구: check_quality · report_finding&#xa;+ ask_user(사람 개입, 고유 도구 아님)&#xa;하네스 도구: write_todos · task(위임) · read_file/glob/grep" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="deep"><mxGeometry x="20" y="50" width="300" height="90" as="geometry"/></mxCell><mxCell id="v24" value="LLM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#b85450;fontColor=#ffffff;fontSize=10;fontStyle=1;" vertex="1" parent="deep"><mxGeometry x="270" y="42" width="34" height="16" as="geometry"/></mxCell><mxCell id="v25" value="미들웨어 (build.py)&#xa;TodoListMiddleware · HideWriteTools(내장 쓰기 숨김)&#xa;RunLedger: 시도 ≤8 · 4회마다 묻기 · 실패 분류(auto/ask/impossible)&#xa;llm_middleware: 녹음/재생 · 토큰 합산(llm 층 인스턴스)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="deep"><mxGeometry x="335" y="50" width="245" height="90" as="geometry"/></mxCell><mxCell id="v26" value="explorer (읽기 전용)&#xa;탐색 — 형태·의존·생성법·유사 테스트&#xa;inspect_target · query_code_graph" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;" vertex="1" parent="deep"><mxGeometry x="20" y="190" width="180" height="70" as="geometry"/></mxCell><mxCell id="v27" value="writer (쓰기·실행 유일)&#xa;지침서+조사 보고로 작성·실행&#xa;write_test · run_tests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;" vertex="1" parent="deep"><mxGeometry x="210" y="190" width="180" height="70" as="geometry"/></mxCell><mxCell id="v28" value="diagnoser (읽기 전용)&#xa;반복 실패 원인 → 수정 지시 / 사람 판단&#xa;inspect_target · query_code_graph" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;" vertex="1" parent="deep"><mxGeometry x="400" y="190" width="180" height="70" as="geometry"/></mxCell><mxCell id="e29" value="task" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="deep" source="v23" target="v26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e30" value="task" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="deep" source="v23" target="v27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e31" value="task" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="deep" source="v23" target="v28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="deep" source="v25" target="v23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v33" value="FilesystemPermission: write 전 경로 deny — 파일을 바꾸는 길은 write_test뿐(ADR-0025 결정 2). general-purpose 서브는 빈 spec으로 무력화. 서브 모델은 메인 것을 물려받음. RECURSION_LIMIT 400. run_agent()가 결과를 WriterState 모양으로 돌려줘 게이트 루프·화면 출력은 두 엔진 공용." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;" vertex="1" parent="deep"><mxGeometry x="20" y="280" width="560" height="60" as="geometry"/></mxCell><mxCell id="e34" value="같은 도구 6개 · 같은 사람 개입 장치" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.12;exitDx=0;exitDy=0;entryX=0;entryY=0.12;entryDx=0;entryDy=0;dashed=1;endArrow=none;" edge="1" parent="engine" source="legacy" target="deep"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tools" value="core/tools/ — 고유 도구 정확히 6개 (R4) · 1도구 1파일 · 문자열 반환 + 길이 상한(clip) · 예외 대신 문장" style="swimlane;startSize=30;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="1100" height="100" as="geometry"/></mxCell><mxCell id="v35" value="inspect_target&#xa;대상 조사&#xa;→ SourceInspector" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;" vertex="1" parent="tools"><mxGeometry x="20" y="40" width="166" height="48" as="geometry"/></mxCell><mxCell id="v36" value="query_code_graph&#xa;미리 정의된 쿼리만&#xa;→ CodeGraph" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;" vertex="1" parent="tools"><mxGeometry x="198" y="40" width="166" height="48" as="geometry"/></mxCell><mxCell id="v37" value="write_test&#xa;테스트 폴더 밖 거부&#xa;→ TestWriter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;" vertex="1" parent="tools"><mxGeometry x="376" y="40" width="166" height="48" as="geometry"/></mxCell><mxCell id="v38" value="run_tests&#xa;빈 selector 거부(R5)&#xa;→ TestRunner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;" vertex="1" parent="tools"><mxGeometry x="554" y="40" width="166" height="48" as="geometry"/></mxCell><mxCell id="v39" value="check_quality&#xa;assert 수 비교&#xa;→ QualityChecker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;" vertex="1" parent="tools"><mxGeometry x="732" y="40" width="166" height="48" as="geometry"/></mxCell><mxCell id="v40" value="report_finding&#xa;한계 보고&#xa;→ (포트 없음)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;" vertex="1" parent="tools"><mxGeometry x="910" y="40" width="166" height="48" as="geometry"/></mxCell><mxCell id="e41" value="도구 호출 (legacy 노드 · deep writer/explorer/diagnoser)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="engine" target="tools"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v42" value="core/ports.py — Protocol 포트 (Fake·실물이 상속 없이 구조적으로 들어맞는다)&#xa;SourceInspector · CodeGraph · TestWriter · TestRunner · QualityChecker · UserGate · TestCodeGenerator · IntentClassifier · TestLocator · ImpactFinder(ADR-0026)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="1100" height="50" as="geometry"/></mxCell><mxCell id="e43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tools" target="v42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="adapters" value="adapters/java — 포트의 구체 구현 (Java · Maven · JUnit 5). core는 이 이름들을 모른다(R1)" style="swimlane;startSize=30;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="720" height="100" as="geometry"/></mxCell><m