<mxfile host="drawio" version="26.0.0" type="device"><diagram name="1. 에이전트 구조"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="Code Test Agent (cta) — 에이전트 구조 아키텍처" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=22;fontColor=#1e1e1e;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="v2" value="LLM이 있는 곳은 llm 층 하나뿐(빨강). 작성 엔진은 둘이 공존하고(--engine legacy|deep) 게이트 루프는 둘을 같은 run_writer 계약으로 부른다. 안전장치(게이트·규칙표·반복 상한·사람 개입)는 전부 일반 코드(R2). 실선 = 호출, 점선 = 프로세스·파일 경계 밖." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1720" height="30" as="geometry"/></mxCell><mxCell id="v3" value="사용자&#xa;(터미널 · CI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8f6;strokeColor=#b5739d;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="150" height="60" as="geometry"/></mxCell><mxCell id="v4" value="cli 층 — cta generate / maintain / resolve 조립·입출력만 (판단 로직 없음)&#xa;cli/generate.py run_generation: 재료 수집 → 엔진 선택 → 게이트 루프 → 제안" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="840" height="60" as="geometry"/></mxCell><mxCell id="e5" value="cta &lt;명령&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v3" target="v4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="engine" value="작성 엔진 — run_writer(state) → WriterState 계약. 둘 중 하나가 돈다(ADR-0024 결정 7)" style="swimlane;startSize=30;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="1100" height="470" as="geometry"/></mxCell><mxCell id="e6" value="run_writer 호출 (지침서·재료)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v4" target="engine"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legacy" value="legacy (기본) — core/writer_graph.py · LangGraph 서브그래프" style="swimlane;startSize=30;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="engine"><mxGeometry x="20" y="40" width="440" height="410" as="geometry"/></mxCell><mxCell id="v7" value="gather&#xa;정보 수집 (inspect_target · query_code_graph)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="legacy"><mxGeometry x="50" y="50" width="190" height="44" as="geometry"/></mxCell><mxCell id="v8" value="write&#xa;generator 포트로 코드 생성 → write_test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="legacy"><mxGeometry x="50" y="120" width="190" height="44" as="geometry"/></mxCell><mxCell id="v9" value="run&#xa;run_tests (선택 실행만)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="legacy"><mxGeometry x="20" y="190" width="190" height="44" as="geometry"/></mxCell><mxCell id="v10" value="quality&#xa;check_quality → status=passed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="legacy"><mxGeometry x="240" y="190" width="180" height="44" as="geometry"/></mxCell><mxCell i