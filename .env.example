# LLM 백엔드 설정 예시 — 이 파일을 .env로 복사해 값을 채운다.
# .env는 gitignore 대상이다. 실제 키·토큰을 이 파일(.env.example)에 쓰지 말 것.

# 백엔드 선택: claude(개발, 기본값) | gateway(사내 운영)
CTA_LLM_PROVIDER=claude

# 모델 이름 (생략 시 provider별 기본값: claude→claude-opus-5, gateway→미확정)
# CTA_LLM_MODEL=claude-opus-5

# --- provider=claude 일 때 ---
# Anthropic API 키 (https://platform.claude.com 에서 발급)
# ANTHROPIC_API_KEY=

# --- provider=gateway 일 때 (사내망) ---
# CTA_GATEWAY_URL=
# CTA_GATEWAY_TOKEN=
