# 사내 LLM 게이트웨이 설정 예시 — 이 파일을 .env로 복사해 값을 채운다.
# .env는 gitignore 대상이다. 실제 주소·키를 이 파일(.env.example)에 쓰지 말 것(v4 6.6).

# 게이트웨이 base URL (사내 안내 문서 참조)
CTA_GATEWAY_URL=

# API 키 (atl-...)
CTA_GATEWAY_API_KEY=

# deployment(모델) 이름. 생략 시 기본값 gpt-4.1
# 제공: gpt-4.1, gpt-4.1-mini, gpt-4o, gpt-4o-mini, gpt-5, gpt-5-mini, gpt-5.4, gpt-5.6-luna
# CTA_LLM_MODEL=gpt-4.1

# API 버전 덮어쓰기 (생략 시 코드 기본값)
# CTA_GATEWAY_API_VERSION=2024-12-01-preview

# --- 코드 그래프 (Neo4j, 2단계) ---
# 로컬 컨테이너 예 (7687=Bolt 드라이버용, 7474=웹 UI):
# docker run -d --name cta-neo4j -e NEO4J_AUTH=neo4j/<암호> -p 7687:7687 -p 7474:7474 neo4j:5
CTA_NEO4J_PASSWORD=
# CTA_NEO4J_URI=bolt://localhost:7687
# CTA_NEO4J_USER=neo4j

# 게이트웨이 응답 대기 상한(초). 생략 시 300. 프로젝트 단위로는 cta.toml [gateway] timeout_sec
# CTA_GATEWAY_TIMEOUT=300
